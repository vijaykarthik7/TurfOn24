# ------------------------------------------------------------------
# TurfOn24 Backend — required environment variables
# Copy this file to .env for local development and set the same
# values (with real credentials) in your Vercel backend project.
# ------------------------------------------------------------------

# Prisma connection string. Required by `prisma generate` / `prisma migrate`
# (see prisma.config.ts) and used at runtime when set.
# Example for a hosted MySQL provider:
# DATABASE_URL="mysql://user:password@host:3306/turfon24"
DATABASE_URL="mysql://user:password@host:3306/turfon24"

# Alternative runtime connection settings (used only when DATABASE_URL
# is NOT set). These mirror the local development .env:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=turfon24

# Express server port (local use only; Vercel provides its own port).
PORT=5000

# Comma-separated allowlist of CORS origins.
# When unset, the defaults are used:
#   https://turf-on24.vercel.app
#   http://localhost:8080, http://localhost:5173, http://localhost:3000
#   http://127.0.0.1:8080, http://127.0.0.1:5173, http://127.0.0.1:3000
CORS_ORIGINS="https://turf-on24.vercel.app,http://localhost:8080,http://localhost:5173"
