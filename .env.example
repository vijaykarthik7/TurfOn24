# ------------------------------------------------------------------
# TurfOn24 Frontend (Vercel) — environment variables
# Copy to .env.local for local development.
# In the Vercel dashboard, add VITE_API_URL to the frontend project.
# ------------------------------------------------------------------

# Production backend URL. Set this to your deployed backend, for example:
#   https://turf-on24-backend.vercel.app
#
# If VITE_API_URL is NOT set, the frontend auto-detects the backend:
#   - localhost / 127.0.0.1  -> http://localhost:5000
#   - any other host (Vercel) -> https://turf-on24-backend.vercel.app
VITE_API_URL="https://turf-on24-backend.vercel.app"
